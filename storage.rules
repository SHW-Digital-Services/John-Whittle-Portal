rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMediaManager() {
      return request.auth != null
        && request.auth.token.email == 'sphw1984@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isPublicBackgroundAudio(fileId) {
      let media = firestore.get(/databases/(default)/documents/media/$(fileId)).data;
      return media.status == 'approved'
        && media.visibility == 'public'
        && media.kind == 'audio'
        && media.audioPurpose == 'background';
    }
    function isApprovedMedia(fileId) {
      return firestore.get(/databases/(default)/documents/media/$(fileId)).data.status == 'approved';
    }
    match /memorial-media/{userId}/{kind}/{fileId} {
      allow read: if (request.auth != null
          && (request.auth.uid == userId || isMediaManager() || isApprovedMedia(fileId)))
        || (kind == 'audio' && isPublicBackgroundAudio(fileId));
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size > 0
        && ((kind == 'picture'
          && request.resource.contentType.matches('image/.*')
          && request.resource.contentType != 'image/svg+xml')
          || (kind == 'video'
          && request.resource.contentType.matches('video/.*'))
          || (kind == 'audio'
          && isMediaManager()
          && request.resource.contentType in ['audio/mpeg', 'audio/mp4', 'audio/wav', 'audio/x-wav', 'audio/ogg', 'audio/webm', 'audio/flac']));
      allow delete: if isMediaManager()
        && (!firestore.exists(/databases/(default)/documents/media/$(fileId))
          || firestore.get(/databases/(default)/documents/media/$(fileId)).data.ownerId == userId);
      allow update: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
