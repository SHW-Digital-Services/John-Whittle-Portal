rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMediaManager() {
      return request.auth != null
        && request.auth.token.email == 'sphw1984@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /memorial-media/{userId}/{kind}/{fileId} {
      allow read: if request.auth != null;
      allow create: if isMediaManager() && request.auth.uid == userId
        && request.resource.size > 0
        && ((kind == 'picture'
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'])
          || (kind == 'audio'
          && request.resource.size <= 50 * 1024 * 1024
          && request.resource.contentType in ['audio/mpeg', 'audio/mp4', 'audio/wav', 'audio/x-wav', 'audio/ogg', 'audio/webm', 'audio/flac']));
      allow delete: if isMediaManager() && request.auth.uid == userId;
      allow update: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
