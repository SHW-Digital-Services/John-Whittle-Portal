rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default safety deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isMediaManager() {
      return isSignedIn()
        && request.auth.token.email == 'sphw1984@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Pending submissions remain private to their uploader and the portal owner.
    match /media/{mediaId} {
      allow read: if (resource.data.visibility == 'public'
          && resource.data.kind == 'audio'
          && resource.data.audioPurpose == 'background'
          && resource.data.status == 'approved')
        || (isSignedIn()
          && (resource.data.get('status', 'approved') == 'approved'
            || isMediaManager()
            || (resource.data.ownerId == request.auth.uid && resource.data.status == 'pending')));
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['ownerId', 'kind', 'title', 'path', 'contentType', 'size', 'createdAt', 'status', 'approvedAt', 'audioPurpose', 'visibility'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind in ['picture', 'video', 'audio']
        && isValidString(request.resource.data.title, 1, 150)
        && request.resource.data.path == 'memorial-media/' + request.auth.uid + '/' + request.resource.data.kind + '/' + mediaId
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'picture'
          && request.resource.data.contentType.matches('image/.*')
          && request.resource.data.contentType != 'image/svg+xml'
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['approvedAt', 'audioPurpose']))
          || (request.resource.data.kind == 'video'
          && request.resource.data.contentType.matches('video/.*')
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['approvedAt', 'audioPurpose']))
          || (request.resource.data.kind == 'audio'
          && isMediaManager()
          && request.resource.data.status == 'approved'
          && request.resource.data.approvedAt == request.time
          && request.resource.data.audioPurpose in ['background', 'altar', 'meditation']
          && ((request.resource.data.audioPurpose == 'background' && request.resource.data.visibility == 'public')
            || (request.resource.data.audioPurpose in ['altar', 'meditation'] && request.resource.data.visibility == 'private'))
          && request.resource.data.contentType in ['audio/mpeg', 'audio/mp4', 'audio/wav', 'audio/x-wav', 'audio/ogg', 'audio/webm', 'audio/flac']
          ));
      allow update: if isMediaManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'visibility'])
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedAt == request.time
        && request.resource.data.get('visibility', resource.data.get('visibility', 'private')) in ['public', 'private']
        && (request.resource.data.get('visibility', resource.data.get('visibility', 'private')) == 'private'
          || (resource.data.kind == 'audio'
            && resource.data.get('audioPurpose', 'background') == 'background'));
      allow delete: if isMediaManager();
    }

    function validOffering(value) {
      return value in ['incense', 'lantern', 'reiki_qi', 'tea', 'lotus', 'candle'];
    }

    function validCounters(data) {
      return data.keys().hasOnly(['incenseLitCount', 'candlesLitCount', 'bellRungCount', 'lanternsReleasedCount', 'teaOfferedCount', 'meditationsCompletedCount'])
        && data.get('incenseLitCount', 0) is int && data.get('incenseLitCount', 0) >= 0
        && data.get('candlesLitCount', 0) is int && data.get('candlesLitCount', 0) >= 0
        && data.get('bellRungCount', 0) is int && data.get('bellRungCount', 0) >= 0
        && data.get('lanternsReleasedCount', 0) is int && data.get('lanternsReleasedCount', 0) >= 0
        && data.get('teaOfferedCount', 0) is int && data.get('teaOfferedCount', 0) >= 0
        && data.get('meditationsCompletedCount', 0) is int && data.get('meditationsCompletedCount', 0) >= 0;
    }

    function incrementsCounter(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Messages are visible only inside the signed-in portal.
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'senderRelationship', 'type', 'content', 'audioBlobUrl', 'audioDurationSeconds', 'offering', 'category', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && isValidString(request.resource.data.senderName, 1, 100)
        && isValidString(request.resource.data.senderRelationship, 1, 100)
        && request.resource.data.type in ['text', 'voice']
        && validOffering(request.resource.data.offering)
        && request.resource.data.category in ['daily', 'wisdom', 'reiki', 'gratitude', 'missing_john', 'prayer']
        && isValidString(request.resource.data.createdAt, 1, 40)
        && ((request.resource.data.type == 'text' && isValidString(request.resource.data.content, 1, 10000)
          && !request.resource.data.keys().hasAny(['audioBlobUrl', 'audioDurationSeconds']))
          || (request.resource.data.type == 'voice' && isValidString(request.resource.data.audioBlobUrl, 1, 900000)
          && request.resource.data.audioDurationSeconds is number && request.resource.data.audioDurationSeconds >= 0
          && !request.resource.data.keys().hasAny(['content'])));
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow update: if false;
    }

    // Signed-out visitors can read condolences. Writing requires login.
    match /condolences/{condolenceId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'relationship', 'message', 'offering', 'createdAt', 'candlesLit', 'isFamily'])
        && request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.authorName, 1, 100)
        && isValidString(request.resource.data.relationship, 1, 100)
        && isValidString(request.resource.data.message, 1, 5000)
        && validOffering(request.resource.data.offering)
        && isValidString(request.resource.data.createdAt, 1, 40)
        && request.resource.data.candlesLit == 1
        && request.resource.data.isFamily is bool;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candlesLit'])
        && request.resource.data.candlesLit is int
        && request.resource.data.candlesLit == resource.data.get('candlesLit', 0) + 1;
      allow delete: if false;
    }

    match /milestones/{milestoneId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'year', 'date', 'title', 'description', 'category', 'hanzi', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.year, 1, 20)
        && isValidString(request.resource.data.title, 1, 150)
        && isValidString(request.resource.data.description, 1, 3000)
        && request.resource.data.category in ['family', 'friends', 'life_journey']
        && isValidString(request.resource.data.createdAt, 1, 40);
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isMediaManager());
    }

    match /shrine/{shrineId} {
      allow read: if isSignedIn() && shrineId == 'global';
      allow create: if isSignedIn() && shrineId == 'global' && validCounters(request.resource.data)
        && request.resource.data.get('incenseLitCount', 0) + request.resource.data.get('candlesLitCount', 0)
          + request.resource.data.get('bellRungCount', 0) + request.resource.data.get('lanternsReleasedCount', 0)
          + request.resource.data.get('teaOfferedCount', 0) + request.resource.data.get('meditationsCompletedCount', 0) == 1;
      allow update: if isSignedIn() && shrineId == 'global' && validCounters(request.resource.data)
        && (incrementsCounter('incenseLitCount') || incrementsCounter('candlesLitCount')
          || incrementsCounter('bellRungCount') || incrementsCounter('lanternsReleasedCount')
          || incrementsCounter('teaOfferedCount') || incrementsCounter('meditationsCompletedCount'));
      allow delete: if false;
    }
  }
}
